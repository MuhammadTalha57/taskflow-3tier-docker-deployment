# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
aws_region        = "ap-south-1"
github_repository = "MuhammadTalha57/taskflow-3tier-docker-deployment"
github_branch     = "main"

# Cost/availability knobs
single_nat_gateway = true
db_multi_az        = false
web_asg            = { min = 2, desired = 2, max = 4 }
app_asg            = { min = 2, desired = 2, max = 4 }

# Set false if your account already has the GitHub OIDC provider
create_github_oidc_provider = true
